# ===== General & LLM Config =====
DATABASE_URL=
EMBEDDING_MODEL=
LITELLM_API_KEY=
LITELLM_BASE_URL=
LITELLM_EMBEDDING_MODEL=
LLM_MODEL=
PG_CONN_STRING=
REDIS_URL=

# ===== ServiceNow Config =====
SERVICENOW_INSTANCE_URL=
SERVICENOW_OAUTH_CLIENT_ID=
SERVICENOW_OAUTH_CLIENT_SECRET=
SERVICENOW_OAUTH_PASSWORD=
SERVICENOW_OAUTH_USERNAME=
SERVICENOW_DEFAULT_CALLER_SYS_ID=

# Our Client behaviour
SERVICENOW_TIMEOUT=30
SERVICENOW_MAX_RETRIES=1

SERVICENOW_KB_TABLE=kb_knowledge
SERVICENOW_KB_SYS_ID=
# Optional S1.4 publishing paths and field mappings.
SERVICENOW_KB_MAPPING_PATH=data/servicenow_kb_mapping.json
SERVICENOW_KB_CATEGORY_MAPPING_PATH=data/kb_category_mapping.json
SERVICENOW_KB_METADATA_FIELD_MAP={}
# Optional approved instance-relative publish action; must contain {sys_id}.
SERVICENOW_KB_PUBLISH_ACTION_PATH=

# Integration test record
INCIDENT_SYS_ID=Our_Testing_Icident_ID

# ===== S1.4 retrieval =====
CORPUS_JSON_PATH=data/kb_dataset.json
COVERAGE_MATRIX_PATH=data/coverage_matrix.csv
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=barq_knowledge_base
QDRANT_DENSE_DIMENSION=
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== S2.1 FastAPI app (Postgres, Redis, webhook auth) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=orchestrator

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

WEBHOOK_AUTH_TOKEN=

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com  

# ===== S2.4 retrieval (query side) =====
# Retrieval mode switch: dense | hybrid | hybrid_rerank  (no code change needed)
RETRIEVAL_MODE=hybrid_rerank
# Passages returned to generation
RETRIEVAL_TOP_K=5
# Candidates fetched per branch (dense / sparse) before fusion + reranking
RETRIEVAL_CANDIDATE_K=20
# Reciprocal Rank Fusion constant
RRF_K=60
# Cross-encoder for hybrid_rerank (fastembed model name)
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Metadata pre-filters: comma-separated lists
ALLOWED_WORKFLOW_STATES=published
BLOCKED_SECURITY_LEVELS=restricted
# Latency budget the ablation report compares p50/p95 against (ms)
LATENCY_BUDGET_MS=500
# Optional: run Qdrant embedded on disk instead of Docker (leave empty to use QDRANT_URL)
QDRANT_LOCAL_PATH=
# Track B: service-desk manual corpus + mentor eval dataset
MANUAL_COLLECTION_NAME=barq_manual
MANUAL_PDF_PATH=data/BARQ_IT_Service_Desk_Manual_Ed5.1.pdf
